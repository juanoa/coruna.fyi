---
import type { GetStaticPaths } from 'astro';
import { render, type CollectionEntry } from 'astro:content';
import { getGuideEntries, getGuideHref } from '../data/guide';
import HomeLayout from '../layouts/HomeLayout.astro';
import NoteList from '../components/NoteList.astro';

export const getStaticPaths = (async () => {
  const entries = await getGuideEntries();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

interface Props { entry: CollectionEntry<'guide'>; }
const { entry: guideEntry } = Astro.props;
const { Content } = await render(guideEntry);
const entry = guideEntry.data;
const entries = await getGuideEntries();
const related = entry.related.map((id) => {
  const note = entries.find((item) => item.id === id);
  if (!note) throw new Error(`Related note is missing or unpublished: ${id}`);
  return { title: note.data.title, href: getGuideHref(note.id), image: note.data.image, description: note.data.description };
});
---

<HomeLayout title={`${entry.title} — coruña.fyi`} description={entry.description}>
  <article>
    <h1 class="text-h1 font-normal leading-tight tracking-heading">{entry.title}</h1>
    <div class="mt-8 space-y-5 text-base leading-copy text-muted [&_h2]:mt-10 [&_h2]:text-h2 [&_h2]:font-medium [&_h2]:text-ink [&_a]:text-ink [&_a]:underline [&_a]:decoration-line [&_a]:underline-offset-4 [&_a:hover]:text-sea [&_a:hover]:decoration-sea [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-sea [&_a:focus-visible]:outline-offset-4 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:my-2">
      <Content />
    </div>
  </article>
  {related.length > 0 && <nav class="mt-12" aria-labelledby="related-title">
    <h2 id="related-title" class="mb-2 text-md font-normal text-muted">Seguir por aquí</h2>
    <NoteList items={related} />
  </nav>}
</HomeLayout>
