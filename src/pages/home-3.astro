---
import HomeLayout from '../layouts/HomeLayout.astro';
import Icon from '../components/Icon.astro';
import GalicianWord from '../components/GalicianWord.astro';
import HomeMap from '../components/HomeMap.astro';
const neighborhoods = [
  { id: 'vella', name: 'Cidade Vella', title: 'Donde las calles bajan la voz.', image: '/images/san-carlos.jpg', alt: 'Piedra tallada y vegetación en el jardín de San Carlos', text: 'Plazas pequeñas, jardines escondidos y piedras que guardan memoria. Un barrio para cambiar el paso y escuchar lo que la ciudad tiene que contar.' },
  { id: 'torre', name: 'Monte Alto', title: 'Un barrio con el norte muy claro.', image: '/images/torre.jpg', alt: 'La Torre de Hércules junto al mar de Monte Alto', text: 'Calles con carácter, vida de barrio y caminos que acaban junto al mar. En Monte Alto, una vuelta sin rumbo puede llevarte hasta el faro.' },
  { id: 'mesa', name: 'Pescadería', title: 'La vida pasa alrededor de una mesa.', image: '/images/polbo.jpg', alt: 'Pulpo á feira para compartir en una mesa', text: 'Conversaciones que salen a la calle, sabores de siempre y una sobremesa que nadie quiere terminar. Aquí el mejor plan empieza con hambre.' },
];
---

<HomeLayout variant={3}>
  <section class="journal-masthead" aria-labelledby="home-title"><div class="journal-masthead-top"><span>UN CUADERNO DE A CORUÑA</span><span>N.º 01 · EL MAR Y LA VIDA</span></div><h1 id="home-title">La vida, <em>a la coruñesa.</em></h1><div class="journal-masthead-bottom"><span>Historias de una ciudad que se vive a pie.</span><span>43°22′ N &nbsp; 8°24′ O</span></div></section>
  <section class="journal-lead" aria-labelledby="lead-title"><div><p class="home-eyebrow">LA HISTORIA DE PORTADA</p><h2 id="lead-title">Siempre hay<br />un camino<br />de vuelta al mar.</h2><p class="home-copy">En A Coruña, el horizonte aparece al doblar una esquina. Salimos a caminar por esa línea que une la ciudad con el Atlántico.</p><button class="home-text-link" data-open-story="riazor" aria-haspopup="dialog">Leer el paseo <Icon name="arrow-up-right" /></button></div><figure><img class="home-photo" src="/images/riazor.jpg" alt="La playa de Riazor abraza la ciudad en una amplia curva junto al Atlántico" width="960" height="720" fetchpriority="high" /><figcaption class="home-caption"><span>Riazor. La ciudad al otro lado de la arena.</span><span>Roberto Abizanda</span></figcaption></figure></section>
  <nav class="journal-index" aria-label="En este cuaderno"><span>EN ESTE CUADERNO</span><a href="#descubrir"><span>01</span>Pequeñas historias</a><a href="#barrios"><span>02</span>La vida de barrio</a><a href="#mapa"><span>03</span>Un mapa para perderse</a></nav>
  <section class="home-section" id="descubrir"><div class="home-section-heading"><div><p class="home-eyebrow">MIRAR UN POCO MÁS CERCA</p><h2>Lo cotidiano tiene mucho que contar.</h2></div></div><div class="journal-stories">
    <article class="journal-story"><img src="/images/marina.jpg" alt="Las galerías de A Mariña se iluminan al caer la tarde" width="1280" height="721" loading="lazy" /><p class="home-eyebrow">LA LUZ DE AQUÍ</p><h3>La última luz se queda en las galerías.</h3><p>El puerto baja el ritmo y A Mariña se enciende. Hay paseos que merecen esperar al final del día.</p><button class="home-text-link" data-open-story="marina" aria-haspopup="dialog">Quedarse un rato <Icon name="arrow-up-right" /></button></article>
    <article class="journal-story"><img src="/images/polbo.jpg" alt="Pulpo con pimentón y patatas sobre un plato para compartir" width="1280" height="960" loading="lazy" /><p class="home-eyebrow clay">SENTARSE A LA MESA</p><h3>Una ración.<br />Y toda la tarde.</h3><p>Del primer trozo de pan a la última conversación. Nuestra forma favorita de alargar el día.</p><button class="home-text-link" data-open-story="mesa" aria-haspopup="dialog">Hacer sitio en la mesa <Icon name="arrow-up-right" /></button></article>
    <aside class="journal-aside"><p class="home-eyebrow">PALABRAS DE AQUÍ</p><h3>Hay una palabra para esta luz.</h3><p>Cuando el día aún no se ha ido y la noche todavía no ha llegado. Ese rato en el que apetece dar otra vuelta.</p><div class="word-link"><GalicianWord word="luscofusco" meaning="El crepúsculo: la luz tenue del momento entre el día y la noche." /></div><p>La lengua también es una forma de mirar.</p></aside>
  </div></section>
  <section class="home-section journal-neighborhood" id="barrios"><p class="home-eyebrow clay">CADA BARRIO, UN MUNDO</p><h2>La ciudad se escribe en sus calles.</h2><div class="neighborhood-picker" role="group" aria-label="Elegir un barrio">{neighborhoods.map((item, i) => <button data-neighborhood={item.id} aria-pressed={i === 0} aria-controls={`neighborhood-${item.id}`}>{item.name}</button>)}</div>
    {neighborhoods.map((item, i) => <div class="neighborhood-spread" id={`neighborhood-${item.id}`} data-neighborhood-panel={item.id} hidden={i !== 0}><img src={item.image} alt={item.alt} width="960" height="640" loading="lazy" /><div><p class="home-eyebrow clay">DENTRO DE {item.name.toUpperCase()}</p><h3>{item.title}</h3><p class="home-copy">{item.text}</p><button class="home-text-link" data-open-story={item.id} aria-haspopup="dialog">Caminar por {item.name} <Icon name="arrow-up-right" /></button></div></div>)}
  </section>
  <HomeMap />
</HomeLayout>

<script>
  const choices = [...document.querySelectorAll<HTMLButtonElement>('[data-neighborhood]')];
  choices.forEach((choice) => choice.addEventListener('click', () => {
    choices.forEach((button) => button.setAttribute('aria-pressed', String(button === choice)));
    document.querySelectorAll<HTMLElement>('[data-neighborhood-panel]').forEach((panel) => { panel.hidden = panel.dataset.neighborhoodPanel !== choice.dataset.neighborhood; });
  }));
</script>
