<script>
  import '../scripts/discovery';
  const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
  const darkStyles = document.querySelector<HTMLLinkElement>('#dark-theme-styles')!;
  const themeChoices = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')];
  function syncColorSamples() {
    const tokens = getComputedStyle(document.documentElement);
    document.querySelectorAll<HTMLButtonElement>('[data-color-token]').forEach((swatch) => {
      const value = tokens.getPropertyValue(`--color-${swatch.dataset.colorToken}`).trim().toUpperCase();
      swatch.dataset.copy = value;
      swatch.setAttribute('aria-label', `Copiar ${swatch.dataset.colorName}: ${value}`);
      const label = swatch.querySelector('[data-color-value]');
      if (label) label.textContent = value;
    });
    const choice = document.documentElement.dataset.theme ?? 'system';
    const dark = choice === 'dark' || (choice === 'system' && systemTheme.matches);
    themeChoices.forEach((button) =>
      button.setAttribute('aria-pressed', String(button.dataset.themeChoice === choice)),
    );
    document.querySelector('[data-system-theme]')!.textContent =
      `${choice === 'system' ? 'System' : 'Preview'} · ${dark ? 'Dark' : 'Light'}`;
  }
  themeChoices.forEach((button) =>
    button.addEventListener('click', () => {
      const choice = button.dataset.themeChoice!;
      if (choice === 'system') delete document.documentElement.dataset.theme;
      else document.documentElement.dataset.theme = choice;
      darkStyles.media =
        choice === 'system' ? '(prefers-color-scheme: dark)' : choice === 'dark' ? 'all' : 'not all';
      document.querySelectorAll<HTMLMetaElement>('meta[data-scheme]').forEach((meta) => {
        meta.media =
          choice === 'system'
            ? `(prefers-color-scheme: ${meta.dataset.scheme})`
            : meta.dataset.scheme === choice
              ? 'all'
              : 'not all';
      });
      try {
        if (choice === 'system') sessionStorage.removeItem('coruna-ds-theme');
        else sessionStorage.setItem('coruna-ds-theme', choice);
      } catch {}
      syncColorSamples();
    }),
  );
  darkStyles.addEventListener('load', syncColorSamples);
  systemTheme.addEventListener('change', syncColorSamples);
  syncColorSamples();

  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const observedSections = [...document.querySelectorAll<HTMLElement>('[data-observed-section]')];
  function updateNavigation() {
    const offset = window.innerWidth <= 760 ? 200 : 90;
    const current =
      observedSections.filter((section) => section.getBoundingClientRect().top <= offset).at(-1) ??
      observedSections[0];
    navLinks.forEach((link) => {
      const active = link.hash === `#${current.id}`;
      if (active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  }
  let navigationFrame = 0;
  window.addEventListener(
    'scroll',
    () => {
      if (navigationFrame) return;
      navigationFrame = requestAnimationFrame(() => {
        updateNavigation();
        navigationFrame = 0;
      });
    },
    { passive: true },
  );
  window.addEventListener('resize', updateNavigation);
  updateNavigation();

  let toastTimeout: ReturnType<typeof setTimeout>;
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) =>
    button.addEventListener('click', async () => {
      const value = button.dataset.copy!;
      const toast = document.querySelector<HTMLElement>('[data-toast]')!;
      try {
        await navigator.clipboard.writeText(value);
        button.dispatchEvent(new Event('color-copied'));
        toast.textContent = `${value} copiado. Un pedacito de Coruña.`;
      } catch {
        toast.textContent = `Color seleccionado: ${value}. Puedes copiarlo del muestrario.`;
      }
      toast.dataset.visible = 'true';
      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => (toast.dataset.visible = 'false'), 3000);
    }),
  );

  document.querySelectorAll<HTMLButtonElement>('[data-card-layout]').forEach((button) =>
    button.addEventListener('click', () => {
      document.querySelector<HTMLElement>('#place-cards')!.dataset.layout = button.dataset.cardLayout!;
      document
        .querySelectorAll<HTMLButtonElement>('[data-card-layout]')
        .forEach((control) => control.setAttribute('aria-pressed', String(control === button)));
    }),
  );

</script>
