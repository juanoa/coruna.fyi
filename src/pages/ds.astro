---
import Layout from '../layouts/Layout.astro';
import GalicianWord from '../components/GalicianWord.astro';
import PlaceCard from '../components/PlaceCard.astro';
import Tag from '../components/Tag.astro';
import CityMap from '../components/CityMap.astro';
import Video from '../components/Video.astro';
import Icon from '../components/Icon.astro';
import IconGallery from '../components/IconGallery.astro';
import ImageGallery from '../components/ImageGallery.astro';
import ThemeControls from '../components/ThemeControls.astro';
import CopyFeedback from '../components/CopyFeedback';
import StoryPreviews from '../components/StoryPreviews.astro';
import { homeVariants, getStory } from '../data/home';
const sections = [
  ['fundamentos', 'Introducción'],
  ['color', 'Color'],
  ['tipografia', 'Tipografía'],
  ['componentes', 'Componentes'],
  ['iconos', 'Iconos'],
  ['imagen', 'Imagen y vídeo'],
  ['mapas', 'Cartografía'],
  ['galego', 'Un poco de galego'],
  ['portadas', 'Portadas'],
  ['estructura', 'Espacio y estructura'],
];
const colors = [
  {
    name: 'Atlántico',
    token: 'sea',
    hex: '#245B73',
    use: 'Enlaces y acciones',
    classes: 'bg-sea text-on-accent',
  },
  { name: 'Papel', token: 'paper', hex: '#FCFCFA', use: 'El lienzo de todo', classes: 'bg-paper text-ink' },
  { name: 'Tinta', token: 'ink', hex: '#202E36', use: 'Texto y titulares', classes: 'bg-ink text-paper' },
  { name: 'Area', token: 'sand', hex: '#E9DDC5', use: 'Calidez y contexto', classes: 'bg-sand text-on-sand' },
  { name: 'Barro', token: 'clay', hex: '#AC4B36', use: 'Lengua y detalles', classes: 'bg-clay text-on-clay' },
  {
    name: 'Monte',
    token: 'moss',
    hex: '#52674C',
    use: 'Naturaleza y rutas',
    classes: 'bg-moss text-on-moss',
  },
];
const supportColors = [
  { name: 'Superficie', token: 'surface', classes: 'bg-surface', hex: '#FFFFFF', use: 'Tarjetas y paneles' },
  {
    name: 'Fondo secundario',
    token: 'soft',
    classes: 'bg-soft',
    hex: '#EEEEE7',
    use: 'Notas y bloques de apoyo',
  },
  {
    name: 'Texto secundario',
    token: 'muted',
    classes: 'bg-muted',
    hex: '#616E6B',
    use: 'Contexto y metadatos',
  },
  { name: 'Bordes', token: 'line', classes: 'bg-line', hex: '#DDDFD7', use: 'Contornos de componentes' },
  {
    name: 'Atlántico suave',
    token: 'sea-light',
    classes: 'bg-sea-light',
    hex: '#E7EFF0',
    use: 'Navegación y mar del mapa',
  },
  {
    name: 'Barro suave',
    token: 'clay-light',
    classes: 'bg-clay-light',
    hex: '#F5E8DF',
    use: 'Selección y etiquetas',
  },
  {
    name: 'Monte suave',
    token: 'moss-light',
    classes: 'bg-moss-light',
    hex: '#E7ECDF',
    use: 'Etiquetas de naturaleza',
  },
];
---

<Layout
  title="Sistema de diseño — coruna.fyi"
  description="El punto de partida de coruna.fyi. Un sistema de diseño editorial, atlántico y cercano para contar A Coruña."
  themePreview
>
  <a
    class="underline underline-offset-4 [-webkit-tap-highlight-color:transparent] focus-visible:outline-3 focus-visible:outline-solid focus-visible:outline-sea focus-visible:outline-offset-5 fixed -top-25 left-5 z-100 py-3 px-5 bg-popover text-popover-ink [&:focus]:top-4"
    href="#contenido"
  >
    Saltar al contenido
  </a>
  <aside class="fixed top-0 right-auto bottom-0 left-0 w-sidebar pt-10.25 pr-6.75 pb-7 pl-6.75 border-r border-line bg-paper flex flex-col z-20 overflow-y-auto [&_nav]:flex [&_nav]:flex-col [&_nav]:gap-1.25 [&_nav]:mt-7 [&_nav]:-mr-2 [&_nav]:mb-0 [&_nav]:-ml-2 max-xl:w-sidebar-xl max-xl:px-5.75 max-lg:w-sidebar-lg max-lg:px-5 max-lg:[&_nav]:mt-6 max-md:sticky max-md:top-0 max-md:w-full max-md:pt-4 max-md:pr-5 max-md:pb-0 max-md:pl-5 max-md:border-r-0 max-md:grid max-md:grid-cols-[1fr_auto] max-md:gap-0 max-md:overflow-y-visible max-md:[&>a]:text-[25px] max-md:[&_nav]:flex-row max-md:[&_nav]:overflow-x-auto max-md:[&_nav]:gap-1.25 max-md:[&_nav]:col-span-full max-md:[&_nav]:row-[3] max-md:[&_nav]:mt-3.75 max-md:[&_nav]:-mr-5 max-md:[&_nav]:mb-0 max-md:[&_nav]:-ml-5 max-md:[&_nav]:pt-0 max-md:[&_nav]:pr-4 max-md:[&_nav]:pb-2.25 max-md:[&_nav]:pl-4 max-md:[&_nav]:[scrollbar-width:thin] max-xs:px-4 max-xs:[&_nav]:-mr-4 max-xs:[&_nav]:-ml-4">
    <a
      class="text-inherit underline-offset-4 [-webkit-tap-highlight-color:transparent] focus-visible:outline-3 focus-visible:outline-solid focus-visible:outline-sea focus-visible:outline-offset-5 font-body text-[27px] font-[650] tracking-[-1.5px] leading-none no-underline [&_span]:text-sea [&_span]:font-normal max-lg:text-[25px]"
      href="/ds/"
      aria-label="coruna.fyi, inicio del sistema de diseño"
    >
      coruna<span>.fyi</span>
    </a>
    <div class="text-meta flex gap-1.5 items-center mt-2 text-muted whitespace-nowrap max-lg:text-2xs max-md:mt-0 max-md:text-caption max-md:gap-1.75 max-xs:text-2xs">
      Sistema de diseño{' '}
      <span class="ml-auto text-caption py-0 px-1.25 border border-line rounded-tag max-md:ml-2">v0.1</span>
    </div>
    <ThemeControls />
    <nav aria-label="Secciones del sistema de diseño">
      {sections.map(([id, label], i) => (
        <a
          href={`#${id}`}
          class="underline-offset-4 [-webkit-tap-highlight-color:transparent] focus-visible:outline-3 focus-visible:outline-solid focus-visible:outline-sea focus-visible:outline-offset-5 flex items-center gap-3.75 py-2.5 px-3 text-label no-underline rounded-sm text-muted [&:hover]:text-sea [&:hover]:bg-sea-light [&[aria-current=location]]:text-sea [&[aria-current=location]]:bg-sea-light [&[aria-current=location]]:font-semibold max-lg:text-meta max-lg:gap-3 max-md:py-2 max-md:px-2.5 max-md:whitespace-nowrap max-md:text-meta max-md:gap-1.75 max-md:min-h-9"
          data-nav-link
          aria-current={i === 0 ? 'location' : undefined}
        >
          <span class="text-caption opacity-70 tabular-nums max-md:text-2xs">
            {String(i + 1).padStart(2, '0')}
          </span>
          {label}
        </a>
      ))}
    </nav>
    <div class="mt-auto pt-7.5 pr-0 pb-0 pl-1.25 text-label leading-copy [&_p]:font-display [&_p]:text-[19px] [&_p]:italic [&_p_span]:text-muted [&_p_span]:font-body [&_p_span]:text-meta [&_p_span]:not-italic max-md:hidden">
      <p class="m-0">
        Feito con calma.
        <br />
        <span>Pensado para A Coruña.</span>
      </p>
      <span class="block text-caption tracking-eyebrow text-muted mt-5">43°22′ N &nbsp; 8°24′ O</span>
    </div>
  </aside>
  <div class="ml-sidebar max-xl:ml-sidebar-xl max-lg:ml-sidebar-lg max-md:ml-0">
    <main id="contenido" class="mx-auto max-w-shell px-14 max-xl:px-9 max-lg:px-7 max-md:px-6 max-sm:px-5">
      <section id="fundamentos" class="pt-13.5 pr-0 pb-0 pl-0 max-md:pt-9" data-observed-section>
        <div class="grid grid-cols-[1.1fr_1fr] gap-9 items-center [&_h1]:leading-[.99] [&_h1]:tracking-[-.045em] [&_h1_em]:text-sea max-xl:gap-5.5 max-xl:[&_h1]:text-[60px] max-lg:gap-4.5 max-lg:[&_h1]:text-[50px] max-md:gap-6.75 max-md:grid-cols-[1.1fr_1fr] max-md:[&_h1]:text-hero-tablet max-sm:grid-cols-1 max-sm:gap-7.5 max-sm:[&_h1]:text-[65px] max-xs:[&_h1]:text-[58px] md:max-lg:[&_h1]:text-[50px]">
          <div class="[&_>_p]:text-muted [&_>_p]:text-reading [&_>_p]:leading-[1.85] [&_>_p]:mt-6 [&_>_:is(a,button)]:mt-6.5 max-sm:[&_>_p]:max-w-[34ch] max-sm:[&_>_:is(a,button)]:mt-6 md:max-lg:[&_>_p]:text-sm sm:max-md:[&_>_p]:text-sm">
            <h1 class="m-0 font-display font-[450] leading-heading tracking-heading text-h1">
              Una ciudad.
              <br />
              Muchas formas
              <br />
              de <em class="[font-weight:inherit]">contarla.</em>
            </h1>
            <p class="m-0">
              El mar, los barrios, la mesa y las palabras.
              <br class="max-md:hidden" /> Un lenguaje visual para descubrir A Coruña
              <br class="max-md:hidden" /> con la curiosidad de quien llega y el cariño
              <br class="max-md:hidden" /> de quien se queda.
            </p>
            <a
              class="underline-offset-4 [-webkit-tap-highlight-color:transparent] focus-visible:outline-3 focus-visible:outline-solid focus-visible:outline-sea focus-visible:outline-offset-5 min-h-control inline-flex items-center justify-center gap-2 py-2.75 px-4 border rounded-sm not-italic font-medium text-sm leading-[1.25rem] font-body tracking-normal text-center no-underline [&:disabled]:text-muted [&:disabled]:bg-soft [&:disabled]:border-line bg-sea text-on-accent border-sea [&:hover]:bg-sea-dark"
              href="#color"
            >
              Así empieza todo <Icon name="arrow-down-right" />
            </a>
          </div>
          <figure class="m-0 relative pb-6.25 [&_>_img]:h-107.5 [&_>_img]:rounded-[6px_100px_6px_6px] [&_>_img]:object-[49%_50%] [&_figcaption]:absolute [&_figcaption]:bottom-0 [&_figcaption]:right-0 [&_figcaption]:text-caption [&_figcaption]:text-muted 2xl:[&_>_img]:h-125 max-xl:[&_>_img]:h-97.5 max-lg:[&_>_img]:h-90 max-md:[&_>_img]:h-85 max-md:[&_>_img]:rounded-tr-[70px] max-sm:ml-3 max-sm:pb-6 max-sm:[&_>_img]:h-87.5 max-sm:[&_>_img]:rounded-tr-[85px] max-sm:[&_figcaption]:text-caption">
            <img
              src="/images/torre.jpg"
              alt="La Torre de Hércules se alza sobre la costa de A Coruña al amanecer"
              width="1000"
              height="1100"
              fetchpriority="high"
              class="block w-full object-cover"
            />
            <div class="absolute -left-5 bottom-13.25 bg-sand text-on-sand pt-4.25 pr-5.75 pb-3.5 pl-5.75 -rotate-5 [&_>_span:first-child]:block [&_>_span:first-child]:italic [&_>_span:first-child]:font-normal [&_>_span:first-child]:text-[30px] [&_>_span:first-child]:leading-[1.1] [&_>_span:first-child]:font-display [&_>_span:last-child]:text-3xs [&_>_span:last-child]:tracking-[.13em] max-md:-left-3 max-md:bottom-12 max-md:py-3.5 max-md:px-4.5 max-md:[&_>_span:first-child]:text-[25px] max-sm:-left-3 max-sm:[&_>_span:first-child]:text-[31px]">
              <span lang="gl">O noso norte.</span>
              <span>A TORRE · A CORUÑA</span>
            </div>
            <figcaption class="mt-2.75 text-caption text-muted leading-[1.7]">
              Una identidad que empieza en el lugar.
            </figcaption>
          </figure>
        </div>
        <div class="grid grid-cols-3 mt-11.5 pt-6.5 gap-7.5 [&_>_div]:relative [&_>_div]:pl-8 [&_>_div_>_span]:absolute [&_>_div_>_span]:left-0 [&_>_div_>_span]:top-0.25 [&_>_div_>_span]:text-clay [&_>_div_>_span]:text-caption [&_h3]:text-[22px] [&_h3]:mb-2.25 [&_p]:text-sm [&_p]:leading-copy [&_p]:text-muted max-md:gap-4.5 max-md:[&_>_div]:pl-6.25 max-md:[&_h3]:text-[22px] max-sm:mt-6.25 max-sm:gap-3.75 max-sm:[&_>_div]:pl-0 max-sm:[&_>_div_>_span]:static max-sm:[&_>_div_>_span]:block max-sm:[&_>_div_>_span]:mb-2.25 max-sm:[&_h3]:text-[23px] max-sm:[&_p]:text-xs max-sm:[&_br]:hidden">
          <div>
            <span>01</span>
            <h3 class="m-0 font-display font-[450] leading-heading tracking-heading text-h3">Atlántico</h3>
            <p class="m-0">
              La luz, la piedra y el mar.
              <br />
              Nuestra paleta ya estaba aquí.
            </p>
          </div>
          <div>
            <span>02</span>
            <h3 class="m-0 font-display font-[450] leading-heading tracking-heading text-h3">Editorial</h3>
            <p class="m-0">
              Historias que apetece leer.
              <br />
              Espacio para mirar y detenerse.
            </p>
          </div>
          <div>
            <span>03</span>
            <h3 class="m-0 font-display font-[450] leading-heading tracking-heading text-h3">De aquí</h3>
            <p class="m-0">
              Una voz cercana y con raíces.
              <br />
              Sin perder el acento.
            </p>
          </div>
        </div>
      </section>

      <section
        id="color"
        class="pt-16 pr-0 pb-0 pl-0 mt-16 max-md:pt-10.75 max-md:mt-10.75"
        data-observed-section
      >
        <div class="flex justify-between items-end gap-6 max-md:[&_h2]:text-[34px] max-sm:block max-sm:[&_h2]:text-5xl">
          <div>
            <p
              class="m-0 not-italic font-medium leading-normal font-body tracking-eyebrow text-sea text-meta mb-3.5"
              data-eyebrow
            >
              <span class="mr-3">02</span> LA PALETA
            </p>
            <h2 class="m-0 font-display font-[450] leading-heading tracking-heading text-h2">
              Los colores ya estaban aquí.
            </h2>
          </div>
          <span
            class="text-muted text-meta pb-1.25 text-right max-lg:max-w-35 max-lg:text-caption max-md:text-caption max-sm:block max-sm:max-w-none max-sm:text-left max-sm:mt-3.25 max-sm:text-meta"
            lang="en"
            data-system-theme
          >
            System
          </span>
        </div>
        <p class="m-0 max-w-155 text-md text-muted mt-4.25 mr-0 mb-6.75 ml-0 leading-copy max-sm:mt-3">
          El papel deja respirar. La tinta cuenta. El Atlántico guía. El resto pone el acento.
        </p>
        <div class="grid grid-cols-6 gap-2.5 max-xl:gap-1.75 max-lg:grid-cols-3 max-lg:gap-y-5 max-sm:gap-y-4 max-sm:gap-x-2.25">
          {colors.map((color) => (
            <button
              class="cursor-pointer text-inherit touch-manipulation [-webkit-tap-highlight-color:transparent] disabled:cursor-not-allowed focus-visible:outline-3 focus-visible:outline-solid focus-visible:outline-sea focus-visible:outline-offset-5 border-0 bg-transparent p-0 text-left min-w-0"
              data-color-token={color.token}
              data-color-name={color.name}
              data-copy={color.hex}
              aria-label={`Copiar ${color.name}: ${color.hex}`}
            >
              <span
                class:list={[
                  'h-34.25 p-3.25 rounded-control flex items-end justify-between border border-ink/10 text-sm max-xl:h-30 max-xl:p-2.5 max-lg:h-31.25 max-sm:h-30.5 max-sm:p-3 max-xs:p-2.25',
                  color.classes,
                ]}
              >
                <span>{color.name}</span>
                <span class="self-start text-label opacity-75">
                  <CopyFeedback client:load />
                </span>
              </span>
              <span class="flex flex-col pt-2.75 gap-0.75 [&_strong]:text-meta [&_strong]:font-medium [&_strong]:tracking-[.035em] [&_>_span]:text-meta [&_>_span]:text-muted max-sm:[&_>_span]:text-caption">
                <strong data-color-value>{color.hex}</strong>
                <span>{color.use}</span>
              </span>
            </button>
          ))}
        </div>
        <div class="flex gap-5 mt-6.75 bg-soft rounded-sm p-4.25 items-center [&_>_[data-eyebrow]]:whitespace-nowrap [&_>_[data-eyebrow]]:text-2xs [&_>_[data-eyebrow]]:text-sea [&_p]:text-label [&_p]:text-muted [&_p]:leading-[1.7] [&_p]:max-w-140 max-sm:items-start max-sm:gap-3.5 max-sm:p-3.75">
          <span class="not-italic font-medium text-xs leading-normal font-body tracking-eyebrow" data-eyebrow>
            LA REGLA
          </span>
          <p class="m-0">
            Mucho papel y tinta. Azul para orientar. Barro y monte, en pequeñas dosis. El color acompaña al
            contenido, sin competir con él.
          </p>
          <span class="ml-auto min-w-30 text-2xs text-muted text-right max-lg:hidden">
            Pulsa un color para copiarlo.
          </span>
        </div>
        <section
          class="mt-10 text-muted text-label [&_h3]:text-ink [&_h3]:not-italic [&_h3]:font-medium [&_h3]:text-base [&_h3]:leading-normal [&_h3]:font-body [&_h3]:mb-3 [&_>_p]:max-w-[65ch]"
          aria-labelledby="support-colors-title"
        >
          <h3
            id="support-colors-title"
            class="m-0 font-display font-[450] leading-heading tracking-heading text-h3"
          >
            Superficies y tonos de apoyo
          </h3>
          <p class="m-0">
            Estos tonos completan la paleta. Sus funciones se mantienen en Light y Dark. Usa el selector de
            apariencia para compararlos o elige System para seguir el ajuste automático.
          </p>
          <div class="grid grid-cols-[repeat(auto-fit,_minmax(min(100%,_240px),_1fr))] gap-3 mt-5">
            {supportColors.map((color) => (
              <button
                class="cursor-pointer text-inherit touch-manipulation [-webkit-tap-highlight-color:transparent] disabled:cursor-not-allowed focus-visible:outline-3 focus-visible:outline-solid focus-visible:outline-sea focus-visible:outline-offset-5 relative flex items-center gap-3 border border-line rounded-sm pt-3.5 pr-11 pb-3.5 pl-3.5 bg-surface text-left [&_strong]:block [&_strong]:text-label [&_strong]:font-medium [&_strong]:text-ink [&_small]:block [&_small]:text-meta [&_small]:text-muted [&_[data-color-value]]:block [&_[data-color-value]]:text-meta [&_[data-color-value]]:mt-1 [&_[data-color-value]]:text-muted"
                data-color-token={color.token}
                data-color-name={color.name}
                data-copy={color.hex}
                aria-label={`Copiar ${color.name}: ${color.hex}`}
              >
                <span class:list={['w-8 h-8 shrink-0 border border-line rounded-sm', color.classes]}></span>
                <span>
                  <strong>{color.name}</strong>
                  <small>{color.use}</small>
                  <span data-color-value>{color.hex}</span>
                </span>
                <span class="absolute top-3.5 right-3.5 text-muted leading-none">
                  <CopyFeedback client:load />
                </span>
              </button>
            ))}
          </div>
        </section>
      </section>

      <section
        id="tipografia"
        class="pt-16 pr-0 pb-0 pl-0 mt-16 max-md:pt-10.75 max-md:mt-10.75"
        data-observed-section
      >
        <div class="flex justify-between items-end gap-6 max-md:[&_h2]:text-[34px] max-sm:block max-sm:[&_h2]:text-5xl">
          <div>
            <p
              class="m-0 not-italic font-medium leading-normal font-body tracking-eyebrow text-sea text-meta mb-3.5"
              data-eyebrow
            >
              <span class="mr-3">03</span> TIPOGRAFÍA
            </p>
            <h2 class="m-0 font-display font-[450] leading-heading tracking-heading text-h2">
              Carácter en el titular.
              <br />
              Claridad en cada línea.
            </h2>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-5 mt-7.75 max-sm:grid-cols-1 max-sm:gap-4 max-sm:mt-6.25">
          <div class="py-6.25 px-7 border border-line rounded-control [&_h3]:text-[30px] [&_h3]:mt-0.25 [&_h3]:mr-0 [&_h3]:mb-2.5 [&_h3]:ml-0 [&_>_p]:text-sm [&_>_p]:text-muted [&_>_p]:max-w-75 max-lg:p-5.25 max-sm:p-6 max-sm:[&_>_p]:max-w-[40ch] bg-soft">
            <div class="flex items-center justify-between gap-3 [&_>_span]:text-2xs [&_>_span]:text-muted max-sm:[&_>_span]:text-caption">
              <span
                class="not-italic font-medium text-xs leading-normal font-body tracking-eyebrow"
                data-eyebrow
              >
                01 · LA VOZ EDITORIAL
              </span>
              <span>Serif</span>
            </div>
            <div class="not-italic font-normal text-[116px] leading-[1.3] font-display mt-3.5 mr-0 mb-0 ml-0 tracking-[-.07em] [&_span]:text-sea">
              Aa<span>g</span>
            </div>
            <h3 class="m-0 font-display font-[450] leading-heading tracking-heading text-h3">Bitter</h3>
            <p class="m-0">
              Para contar historias, dar protagonismo a un lugar y dejar que una palabra tenga carácter.
            </p>
            <div class="mt-6 not-italic font-normal text-base leading-copy font-display max-lg:text-md max-sm:text-[19px]">
              Aa Bb Cc Dd Ee Ff Gg Hh Ii Ññ
              <br />
              <em class="[font-weight:inherit]">A Coruña, a cidade que queremos.</em>
            </div>
          </div>
          <div class="py-6.25 px-7 border border-line rounded-control [&_h3]:text-[30px] [&_h3]:mt-0.25 [&_h3]:mr-0 [&_h3]:mb-2.5 [&_h3]:ml-0 [&_>_p]:text-sm [&_>_p]:text-muted [&_>_p]:max-w-75 max-lg:p-5.25 max-sm:p-6 max-sm:[&_>_p]:max-w-[40ch] [&>div:nth-child(2)]:font-body [&>div:nth-child(2)]:text-[104px] [&>div:nth-child(2)]:leading-[1.45] [&>div:nth-child(2)]:font-[450] [&>h3]:font-body [&>h3]:text-[25px] [&>h3]:font-medium [&>div:last-child]:font-body [&>div:last-child]:text-label [&>div:last-child]:leading-[2.4] max-sm:[&>div:last-child]:text-md">
            <div class="flex items-center justify-between gap-3 [&_>_span]:text-2xs [&_>_span]:text-muted max-sm:[&_>_span]:text-caption">
              <span
                class="not-italic font-medium text-xs leading-normal font-body tracking-eyebrow"
                data-eyebrow
              >
                02 · LA VOZ COTIDIANA
              </span>
              <span>Sans serif</span>
            </div>
