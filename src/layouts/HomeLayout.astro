---
import '@fontsource-variable/montserrat/index.css';
import Layout from './Layout.astro';
import SiteSearch from '../components/SiteSearch';
import { getSearchPages } from '../data/guide';
interface Props { title?: string; description?: string; }
const { title = 'coruña.fyi — Una forma de mirar Coruña', description = 'Apuntes sobre Coruña. Lugares, paseos y pequeñas cosas que se van conectando.' } = Astro.props;
const searchPages = await getSearchPages();
const focus = 'focus-visible:outline-2 focus-visible:outline-sea focus-visible:outline-offset-4';
---

<Layout title={title} description={description}>
  <div class="mx-auto w-full max-w-shell px-6 sm:px-8">
    <a class:list={['fixed -top-25 left-5 z-100 bg-paper px-5 py-3 focus:top-4', focus]} href="#contenido">Saltar al contenido</a>
    <header class="flex items-center justify-between gap-6 pt-10 pb-14 sm:pt-16 sm:pb-18" id="inicio">
      <a href="/" class:list={['whitespace-nowrap font-logo text-[27px] font-[650] leading-none tracking-[-1.5px] text-ink [&_span]:font-normal [&_span]:text-sea', focus]} aria-label="coruña.fyi, inicio">coruña<span>.fyi</span></a>
      <SiteSearch searchPages={searchPages} client:load />
    </header>
    <main id="contenido"><slot /></main>
    <footer class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-line py-6 text-sm text-muted sm:mt-20 sm:pb-12">
      <p>Unas notas sobre Coruña.</p>
      <a class:list={['py-2 underline decoration-line underline-offset-4 hover:text-sea hover:decoration-sea', focus]} href="/">Volver al principio</a>
    </footer>
  </div>
</Layout>
