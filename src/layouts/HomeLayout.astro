---
import Layout from './Layout.astro';
import Icon from '../components/Icon.astro';
import SiteSearch from '../components/SiteSearch';
import { getSearchPages } from '../data/guide';
interface Props { title?: string; description?: string; }
const { title = 'Guía de A Coruña — coruña.fyi', description = 'Guía de A Coruña: lugares, playas, barrios, gastronomía y rutas a pie.' } = Astro.props;
const searchPages = await getSearchPages();
const shell = 'mx-auto w-full max-w-shell px-12 2xl:px-14 max-lg:px-8 max-md:px-6 max-sm:px-5';
const focus = 'focus-visible:outline-3 focus-visible:outline-sea focus-visible:outline-offset-5';
const logo = 'whitespace-nowrap text-[27px] font-[650] leading-none tracking-[-1.5px] text-ink [&_span]:font-normal [&_span]:text-sea';
---

<Layout title={title} description={description}>
  <div class="home [&_:is(a,button)]:[-webkit-tap-highlight-color:transparent]">
    <a class:list={['fixed -top-25 left-5 z-100 bg-popover px-5 py-3 text-popover-ink focus:top-4', focus]} href="#contenido">Saltar al contenido</a>
    <header class:list={[shell, 'flex items-center gap-8 py-7 max-md:gap-5 max-md:py-5 max-sm:flex-wrap max-sm:gap-2 max-sm:pt-6 max-sm:pb-3']} id="inicio">
      <a href="/" class:list={[logo, focus]} aria-label="coruña.fyi, inicio">coruña<span>.fyi</span></a>
      <div class="ml-auto flex"><SiteSearch searchPages={searchPages} client:load /></div>
    </header>
    <main id="contenido" class={shell}><slot /></main>
    <footer class:list={[shell, 'mt-22 pb-8 max-sm:mt-16']}>
      <div class="flex justify-between gap-8 py-9 max-sm:flex-col max-sm:gap-5 max-sm:py-7">
        <div><a href="#inicio" class:list={[logo, focus]}>coruña<span>.fyi</span></a><p class="mt-4 text-xs text-muted">Hecho con calma. Pensado para A Coruña.</p></div>
        <a class:list={['inline-flex min-h-control items-center gap-3 text-label font-medium text-sea hover:underline hover:underline-offset-5', focus]} href="#inicio">Volver arriba <Icon name="arrow-up" /></a>
      </div>
    </footer>
  </div>
</Layout>

<script>
  import '../scripts/discovery';
</script>
