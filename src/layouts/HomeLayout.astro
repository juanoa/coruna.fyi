---
import Layout from './Layout.astro';
import Icon from '../components/Icon.astro';
import '../styles/home.css';
interface Props { title?: string; description?: string; }
const { title = 'Guía de A Coruña — coruna.fyi', description = 'Guía de A Coruña: lugares, playas, barrios, gastronomía y rutas a pie.' } = Astro.props;
---

<Layout title={title} description={description}>
  <div class="home">
    <a class="home-skip" href="#contenido">Saltar al contenido</a>
    <header class="home-shell home-header" id="inicio">
      <a href="/" class="home-logo" aria-label="coruna.fyi, inicio">coruna<span>.fyi</span></a>
    </header>
    <main id="contenido" class="home-shell"><slot /></main>
    <footer class="home-shell home-footer">
      <div class="footer-top">
        <div><a href="#inicio" class="home-logo">coruna<span>.fyi</span></a><p>Hecho con calma. Pensado para A Coruña.</p></div>
        <a class="home-text-link" href="#inicio">Volver arriba <Icon name="arrow-up" /></a>
      </div>
    </footer>
  </div>
</Layout>

<script>
  import '../scripts/discovery';
</script>
