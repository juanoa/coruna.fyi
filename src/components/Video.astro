---
interface Props { src?: string; poster: string; title: string; caption: string; captionsSrc?: string }
const { src, poster, title, caption, captionsSrc } = Astro.props;
---
<figure class="video-example">
  {src ? <video controls preload="none" poster={poster} aria-label={title} playsinline>{captionsSrc && <track kind="captions" src={captionsSrc} srclang="es" label="Español" default />}<source src={src} /></video> : <div class="video-empty" style={`background-image: linear-gradient(0deg, rgb(15 33 42 / .78), transparent 75%), url('${poster}')`}><span class="video-status">VÍDEO EDITORIAL · 16:9</span><div><h3>{title}</h3><p>Este espacio espera su primera historia en vídeo.</p></div></div>}
  <figcaption>{caption}</figcaption>
</figure>
