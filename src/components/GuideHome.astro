---
import HomeLayout from '../layouts/HomeLayout.astro';
import Icon from './Icon.astro';
import PlaceCard from './PlaceCard.astro';
import HomeMap from './HomeMap.astro';
import { getGuideEntries, getGuideEntry, getGuideHref } from '../data/guide';

const entries = await getGuideEntries();
const stories = entries.filter(({ data }) => data.homeFilter);
const neighborhoods = entries.filter(({ data }) => data.section === 'neighborhoods');
const towerRoute = await getGuideEntry('torre-de-hercules-y-menhires');
const filters = [
  { id: 'all', label: 'Todo', icon: 'compass' },
  { id: 'sea', label: 'Mar y playas', icon: 'waves' },
  { id: 'dining', label: 'Gastronomía', icon: 'utensils' },
  { id: 'walks', label: 'Paseos', icon: 'footprints' },
  { id: 'history', label: 'Monumentos y barrios', icon: 'book-open' },
] as const;
const heading = 'font-display font-[450] leading-heading tracking-heading';
const focus = 'focus-visible:outline-3 focus-visible:outline-sea focus-visible:outline-offset-5';
const sectionHeading = 'mb-7 flex items-end justify-between gap-8 max-md:items-start max-md:gap-6 max-sm:mb-6 max-sm:flex-col max-sm:gap-3';
---

<HomeLayout>
  <section class="pt-12 text-center max-sm:pt-8" aria-labelledby="home-title">
    <p class="mb-5 text-meta font-[550] leading-[1.6] tracking-eyebrow text-sea">GUÍA DE A CORUÑA</p>
    <h1 class:list={[heading, 'text-[clamp(44px,5.2vw,72px)] max-sm:text-[clamp(42px,11vw,58px)]']} id="home-title">¿Qué te apetece <em class="text-sea">hoy?</em></h1>
    <p class="mx-auto mt-5 max-w-[56ch] text-reading leading-copy text-muted max-md:text-md">Lugares que visitar, playas, gastronomía y rutas a pie.<br class="max-sm:hidden" /> Encuentra qué hacer en A Coruña.</p>
  </section>
  <section class="mt-8" id="descubrir" aria-label="Encuentra un plan">
    <div class="mb-9 flex flex-wrap justify-center gap-3 max-sm:mb-6 max-sm:gap-2" role="group" aria-label="Qué te apetece hacer">
      {filters.map((filter, i) => <button class:list={['flex min-h-12 cursor-pointer items-center justify-center gap-2.5 rounded-pill border border-line px-5 py-3 text-label text-muted aria-pressed:border-sea aria-pressed:bg-sea aria-pressed:text-on-accent [&:hover:not([aria-pressed=true])]:bg-sea-light [&:hover:not([aria-pressed=true])]:text-sea max-sm:min-h-control max-sm:gap-2 max-sm:px-3.5 max-sm:py-2.5 max-sm:text-xs', focus]} data-home-filter={filter.id} aria-pressed={i === 0} aria-controls="guide-results"><Icon name={filter.icon} size={20} />{filter.label}</button>)}
    </div>
    <div class="mb-5 flex items-center justify-between gap-6 pt-6"><h2 class:list={[heading, 'text-2xl']}>Qué ver y hacer</h2><p class="text-meta text-muted max-sm:max-w-[13ch] max-sm:text-right" data-results-count role="status">{stories.length} propuestas</p></div>
    <div class="grid grid-cols-3 gap-x-6 gap-y-7 max-md:grid-cols-2 max-md:gap-5 max-sm:grid-cols-1 max-sm:gap-6 [&_article]:h-full [&_h3]:text-h3 [&_h3]:leading-heading" id="guide-results">
      {stories.map(({ id, data }) => <div class="min-w-0" data-home-result={data.homeFilter}><PlaceCard {...data} href={getGuideHref(id)} /></div>)}
    </div>
    <noscript><p class="max-w-[43ch] text-reading leading-copy text-muted max-md:text-md">Se muestran todas las propuestas. Puedes abrir sus páginas sin JavaScript; actívalo para usar los filtros.</p></noscript>
  </section>
  <section class="mt-22 grid grid-cols-2 overflow-hidden rounded-card bg-moss-light max-md:mt-16 max-md:grid-cols-1" aria-labelledby="itinerary-title">
    <img class="h-full min-h-112.5 w-full object-cover max-md:h-70 max-md:min-h-0" src="/images/menhires.jpg" alt="Los Menhires pola Paz entre la hierba y el horizonte del Atlántico" width="960" height="494" loading="lazy" />
    <div class="p-10 max-lg:p-8 max-sm:px-6 max-sm:py-7">
      <p class="mb-5 text-meta font-[550] leading-[1.6] tracking-eyebrow text-moss">RUTA A PIE · 2 HORAS APROXIMADAMENTE</p>
      <h2 class:list={[heading, 'max-w-[12ch] text-h2 max-md:max-w-[18ch] max-sm:text-[34px]']} id="itinerary-title">{towerRoute.data.title}</h2>
      <p class="mt-5 text-sm leading-copy text-muted">{towerRoute.data.description}</p>
      <ol class="my-6 [&_li]:flex [&_li]:items-center [&_li]:gap-4 [&_li]:border-t [&_li]:border-map-border [&_li]:py-3 [&_li]:text-sm [&_span]:text-meta [&_span]:text-moss"><li><span>01</span>Playa de As Lapas</li><li><span>02</span>Torre de Hércules</li><li><span>03</span>Menhires pola Paz</li></ol>
      <a class:list={['inline-flex min-h-control items-center justify-center gap-3 rounded-sm border border-ink bg-transparent px-5 py-3 text-sm font-medium leading-[1.4] text-ink hover:bg-sea-light hover:text-sea', focus]} href={getGuideHref(towerRoute.id)}>Ver ruta <Icon name="arrow-up-right" /></a>
    </div>
  </section>
  <section class="mt-22 scroll-mt-8 max-md:mt-16" id="barrios">
    <div class={sectionHeading}>
      <div><p class="mb-3 text-meta font-[550] leading-[1.6] tracking-eyebrow text-sea">EXPLORAR LA CIUDAD</p><h2 class:list={[heading, 'text-h2 max-sm:text-[34px]']}>Barrios de A Coruña</h2></div>
      <p class="text-right text-label leading-copy text-muted max-md:hidden">Ubicación y recorridos a pie.</p>
    </div>
    <div class="grid grid-cols-3 gap-6 max-md:gap-5 max-sm:grid-cols-1 max-sm:gap-7">
      {neighborhoods.map(({ id, data: neighborhood }) => <article class="relative rounded-photo focus-within:outline-3 focus-within:outline-sea focus-within:outline-offset-5">
        <img class="h-50 w-full rounded-photo object-cover max-md:h-40 max-sm:h-60" src={neighborhood.image} alt={neighborhood.alt} width="960" height="640" loading="lazy" />
        <h3 class:list={[heading, 'mt-4 mb-2 flex items-center justify-between gap-3 text-h3 max-md:text-2xl max-sm:text-3xl']}><a class="flex w-full items-center justify-between gap-3 text-left after:absolute after:inset-0 hover:text-sea focus-visible:outline-none" href={getGuideHref(id)}>{neighborhood.title} <Icon name="arrow-up-right" size={20} class="text-sea" /></a></h3>
        <p class="text-sm text-muted max-md:text-xs max-sm:text-sm">{neighborhood.description}</p>
      </article>)}
    </div>
  </section>
  <HomeMap />
</HomeLayout>

<script>
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-home-filter]')];
  const results = [...document.querySelectorAll<HTMLElement>('[data-home-result]')];
  filters.forEach((button) => button.addEventListener('click', () => {
    filters.forEach((filter) => filter.setAttribute('aria-pressed', String(filter === button)));
    results.forEach((result) => { result.hidden = button.dataset.homeFilter !== 'all' && result.dataset.homeResult !== button.dataset.homeFilter; });
    const count = results.filter((result) => !result.hidden).length;
    const status = document.querySelector('[data-results-count]');
    if (status) status.textContent = `${count} ${count === 1 ? 'propuesta' : 'propuestas'}`;
  }));
</script>
