---
import Icon from './Icon.astro';
import geography from '../data/coruna-map.json';

type Feature = {
  properties: { kind: string; road_type?: string };
  geometry: { type: string; coordinates: number[][] | number[][][] };
};
const { width, height, reference_latitude } = geography.projection;
const [west, , east, north] = geography.bbox;
const latitudeScale = width / ((east - west) * Math.cos((reference_latitude * Math.PI) / 180));
const project = ([lon, lat]: number[]) => [
  ((lon - west) / (east - west)) * width,
  (north - lat) * latitudeScale,
];
const features = geography.features as Feature[];
function path(feature: Feature) {
  const polygon = feature.geometry.type === 'Polygon';
  const lines = polygon
    ? (feature.geometry.coordinates as number[][][])
    : [feature.geometry.coordinates as number[][]];
  return lines
    .map(
      (line) =>
        line
          .map(
            (point, index) =>
              `${index ? 'L' : 'M'}${project(point)
                .map((n) => n.toFixed(1))
                .join(',')}`,
          )
          .join('') + (polygon ? 'Z' : ''),
    )
    .join('');
}
const paths = (kind: string) =>
  features
    .filter((feature) => feature.properties.kind === kind)
    .map(path)
    .join('');
const land = paths('land') + paths('island');
const majorTypes = [
  'bg-sea text-on-accent border-sea [&:hover]:bg-sea-dark',
  'border-ink [&:hover]:bg-sea-light',
  'text-sea border-transparent [&:hover]:bg-sea-light',
];
const streets = features.filter((feature) => feature.properties.kind === 'road');
const majorRoads = streets
  .filter((feature) => majorTypes.includes(feature.properties.road_type ?? ''))
  .map(path)
  .join('');
const localRoads = streets
  .filter((feature) => !majorTypes.includes(feature.properties.road_type ?? ''))
  .map(path)
  .join('');
const places = [
  {
    id: 'torre',
    number: '01',
    name: 'Torre de Hércules',
    category: 'patrimonio',
    label: 'Patrimonio',
    description: 'Un faro, un horizonte y un paseo para mirar al Atlántico.',
    position: [-8.40652, 43.38594],
  },
  {
    id: 'orzán',
    number: '02',
    name: 'Orzán y Riazor',
    category: 'paseos',
    label: 'Paseos',
    description: 'La ciudad se abre al mar. Un recorrido junto a las playas del Orzán y Riazor.',
    position: [-8.405113, 43.371916],
  },
  {
    id: 'vella',
    number: '03',
    name: 'Cidade Vella',
    category: 'patrimonio',
    label: 'Patrimonio',
    description: 'Plazas pequeñas, calles de piedra e historias para descubrir a pie.',
    position: [-8.3926, 43.3714],
  },
  {
    id: 'marina',
    number: '04',
    name: 'A Mariña',
    category: 'paseos',
    label: 'Paseos',
    description: 'Galerías blancas frente al puerto. Un buen lugar para empezar a conocer la ciudad.',
    position: [-8.4003, 43.3688],
  },
].map((place) => {
  const [x, y] = project(place.position);
  return { ...place, x, y };
});
---

<div class="grid grid-cols-[1.7fr_1fr] border border-line rounded-card overflow-hidden max-lg:grid-cols-[1.35fr_1fr] max-md:grid-cols-[1.3fr_1fr] max-sm:grid-cols-1 md:max-lg:grid-cols-1 sm:max-md:grid-cols-1">
  <div class="bg-sea-light min-w-0 flex flex-col justify-between">
    <div class="flex justify-between items-center pt-5.5 pr-6 pb-0 pl-6 text-sea [&_>_[data-eyebrow]]:text-3xs">
      <span class="not-italic font-medium text-xs leading-normal font-body tracking-eyebrow" data-eyebrow>
        A CORUÑA, A VISTA DE PÁXARO
      </span>
      <span class="inline-flex items-center gap-1.5 text-meta" aria-label="Norte">
        N <Icon name="arrow-up" />
      </span>
    </div>
    <svg
      class="block w-full h-auto flex-1"
      viewBox={`0 0 ${width} ${height}`}
      role="group"
      aria-labelledby="map-title"
      aria-describedby="map-desc"
    >
      <title id="map-title">Mapa de la península de A Coruña</title>
      <desc id="map-desc">
        Costa, playas, parques y calles a partir de datos de OpenStreetMap. Norte arriba: la Torre de Hércules
        al norte, la ensenada del Orzán al oeste y la Cidade Vella y el puerto al este. Los puntos numerados
        también se pueden seleccionar en la lista.
      </desc>
      <defs>
        <clipPath id="city-land-clip">
          <path d={land} />
        </clipPath>
      </defs>
      <path class="fill-paper stroke-map-border [stroke-width:1.4px] [stroke-linejoin:round]" d={land} />
      <g clip-path="url(#city-land-clip)" aria-hidden="true">
        <path class="fill-map-park" d={paths('park')} />
        <path
          class="fill-[none] [stroke-linecap:round] [stroke-linejoin:round] stroke-line [stroke-width:1.1px]"
          d={localRoads}
        />
        <path
          class="fill-[none] [stroke-linecap:round] [stroke-linejoin:round] stroke-map-border [stroke-width:4px]"
          d={majorRoads}
        />
        <path
          class="fill-[none] [stroke-linecap:round] [stroke-linejoin:round] stroke-paper [stroke-width:2.2px]"
          d={majorRoads}
        />
        <path
          class="fill-[none] [stroke-linecap:round] [stroke-linejoin:round] stroke-moss [stroke-width:.8px] opacity-45"
          d={paths('path')}
        />
      </g>
      <path class="fill-sand stroke-sand-border [stroke-width:.5px]" d={paths('beach')} aria-hidden="true" />
      <g class="fill-sea italic font-normal text-[22px] leading-[normal] font-display" aria-hidden="true">
        <text x="117" y="255" text-anchor="middle">
          <tspan x="117">Ensenada</tspan>
          <tspan x="117" dy="24">
            del Orzán
          </tspan>
        </text>
        <text x="623" y="322" text-anchor="middle">
          <tspan x="623">Ría da</tspan>
          <tspan x="623" dy="24">
            Coruña
          </tspan>
        </text>
        <text x="115" y="57" class="text-base">
          Océano Atlántico
        </text>
      </g>
      <g
        class="fill-muted not-italic font-normal text-meta leading-[normal] font-body tracking-[1.5px] [paint-order:stroke] stroke-paper [stroke-width:4px] [stroke-linejoin:round]"
        aria-hidden="true"
      >
        <text x="348" y="272" text-anchor="middle">
          MONTE ALTO
        </text>
        <text x="171" y="529" text-anchor="middle">
          RIAZOR
        </text>
        <text x="244" y="587" text-anchor="middle">
          ENSANCHE
        </text>
        <text x="359" y="435" text-anchor="middle">
          PESCADERÍA
        </text>
      </g>
      <g
        class="fill-ink not-italic font-medium text-sm leading-[normal] font-body [paint-order:stroke] stroke-paper [stroke-width:4px] [stroke-linejoin:round]"
        aria-hidden="true"
      >
        <text x="317" y="113">
          Torre de Hércules
        </text>
        <text x="267" y="383" text-anchor="end">
          Orzán
        </text>
        <text x="485" y="383" text-anchor="middle">
          Cidade Vella
        </text>
        <text x="404" y="487">
          A Mariña
        </text>
        <text x="199" y="443" text-anchor="middle" class="text-xs fill-muted">
          Riazor
        </text>
        <text x="294" y="193" text-anchor="middle" class="text-xs fill-muted">
          As Lapas
        </text>
        <text x="461" y="210" class="text-xs fill-muted">
          Santo Amaro
        </text>
        <text x="553" y="646" class="text-xs fill-muted">
          Porto da Coruña
        </text>
      </g>
      {places.map((place, i) => (
        <g
          class="[&_circle:first-of-type]:fill-transparent [&_circle:first-of-type]:stroke-[none] [&_text]:fill-sea [&_text]:[text-anchor:middle] [&_text]:not-italic [&_text]:font-medium [&_text]:text-xs [&_text]:leading-[normal] [&_text]:font-body [&[aria-pressed=true]_circle:nth-of-type(2)]:fill-clay [&[aria-pressed=true]_circle:nth-of-type(2)]:stroke-clay [&[aria-pressed=true]_text]:fill-on-clay cursor-pointer [&:focus-visible]:outline-none [&:focus-visible_circle:nth-of-type(2)]:stroke-ink [&:focus-visible_circle:nth-of-type(2)]:[stroke-width:4px] [&:hover_circle:nth-of-type(2)]:[stroke-width:3px] data-[hidden=true]:hidden"
          data-map-marker={place.id}
          role="button"
          tabindex="0"
          aria-label={`Seleccionar ${place.name}`}
          aria-pressed={i === 0}
        >
          <circle cx={place.x} cy={place.y} r="30" />
          <circle class="fill-paper stroke-sea [stroke-width:1.5px]" cx={place.x} cy={place.y} r="19" />
          <text x={place.x} y={place.y + 4}>
            {place.number}
          </text>
        </g>
      ))}
    </svg>
    <div class="flex justify-between flex-wrap gap-y-2 gap-x-3 py-3.75 px-5 text-caption text-sea max-lg:flex-col max-lg:text-3xs max-sm:flex-row max-sm:text-3xs">
      <span>Costa, calles, parques y playas</span>
      <a
        href="https://www.openstreetmap.org/copyright"
        target="_blank"
        rel="noreferrer"
        class="text-inherit underline underline-offset-4 [-webkit-tap-highlight-color:transparent] focus-visible:outline-3 focus-visible:outline-solid focus-visible:outline-sea focus-visible:outline-offset-5"
      >
        © OpenStreetMap contributors
      </a>
    </div>
  </div>
  <div class="min-w-0 flex flex-col gap-4 p-6 bg-surface [&_h3]:text-4xl [&_h3]:leading-[1.15] [&_h3]:mt-2 [&_h3]:mr-0 [&_h3]:mb-0 [&_h3]:ml-0 max-lg:[&_h3]:text-[30px] max-sm:p-6 md:max-lg:[&_h3_br]:hidden">
    <div class="[&_>_[data-eyebrow]]:text-caption [&_>_[data-eyebrow]]:text-muted">
      <p class="m-0 not-italic font-medium text-xs leading-normal font-body tracking-eyebrow" data-eyebrow>
        CADA LUGAR, UNA HISTORIA
      </p>
      <h3 class="m-0 font-display font-[450] leading-heading tracking-heading text-h3">
        Nos vemos
        <br />
        en el mapa.
      </h3>
    </div>
    <div class="flex flex-wrap gap-2" aria-label="Filtrar lugares">
      {['Todos', 'Patrimonio', 'Paseos'].map((label, i) => (
        <button
          class="cursor-pointer touch-manipulation [-webkit-tap-highlight-color:transparent] disabled:cursor-not-allowed focus-visible:outline-3 focus-visible:outline-solid focus-visible:outline-sea focus-visible:outline-offset-5 bg-transparent border border-line text-muted rounded-pill py-2 px-3 text-xs leading-[18px] min-h-9 [&[aria-pressed=true]]:text-on-accent [&[aria-pressed=true]]:bg-sea [&[aria-pressed=true]]:border-sea"
          data-map-filter={i === 0 ? 'all' : label.toLowerCase()}
          aria-pressed={i === 0}
        >
          {label}
        </button>
      ))}
    </div>
    <div class="flex flex-col gap-1">
      {places.map((place, i) => (
        <button
          class="cursor-pointer text-inherit touch-manipulation [-webkit-tap-highlight-color:transparent] disabled:cursor-not-allowed focus-visible:outline-3 focus-visible:outline-solid focus-visible:outline-sea focus-visible:outline-offset-5 grid grid-cols-[18px_minmax(0,_1fr)] w-full min-h-15 p-3 border-0 bg-transparent text-left items-center content-center gap-2 text-sm leading-[20px] rounded-photo transition-colors duration-160 ease-[ease] [&_>_span:first-child]:text-meta [&_>_span:first-child]:text-muted [&_>_span:first-child]:self-start [&_small]:text-xs [&_small]:leading-[16px] [&_small]:text-muted [&_small]:block [&_small]:mt-0.5 [&[aria-pressed=true]]:bg-clay-light [&:focus-visible:not([aria-pressed=true])]:bg-sea-light [@media(hover:hover)_and_(pointer:fine)]:[&:hover:not([aria-pressed=true])]:bg-sea-light [@media(hover:hover)_and_(pointer:fine)]:[&[aria-pressed=true]:hover]:bg-[color-mix(in_srgb,_var(--color-clay-light)_90%,_var(--color-clay))] motion-reduce:transition-none [&[aria-pressed=true]_>_span:first-child]:text-clay [&[hidden]]:hidden"
          data-map-place={place.id}
          data-category={place.category}
          data-description={place.description}
          aria-pressed={i === 0}
        >
          <span>{place.number}</span>
          <span>
            {place.name}
            <small>{place.label}</small>
          </span>
        </button>
      ))}
    </div>
    <p class="m-0 text-label leading-copy text-muted" data-map-description aria-live="polite">
      {places[0].description}
    </p>
  </div>
</div>
