---
import Icon from './Icon.astro';

interface Props {
  items: { title: string; href: string; image: string; description?: string }[];
}
const { items } = Astro.props;
---

<ul class="space-y-1" role="list">
  {items.map((item) => (
    <li>
      <a href={item.href} class="group flex min-h-control items-center gap-3 rounded-card border border-line/70 p-1.5 pr-3 hover:bg-soft/50 focus-visible:bg-soft/50 focus-visible:outline-2 focus-visible:outline-sea focus-visible:outline-offset-2">
        <img src={item.image} alt="" width="48" height="48" loading="lazy" decoding="async" class="size-12 shrink-0 rounded-sm object-cover" />
        <span class="min-w-0 flex-1">
          <span class="block text-md font-medium leading-body text-ink">{item.title}</span>
          {item.description && <span class="block text-label leading-body text-muted">{item.description}</span>}
        </span>
        <Icon name="arrow-up-right" size={16} class="text-muted [@media(hover:hover)]:opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100" />
      </a>
    </li>
  ))}
</ul>
